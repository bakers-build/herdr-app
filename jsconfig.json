{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "checkJs": true,
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "herdr": ["./types/herdr.d.ts"],
      "gpui-kit": ["./types/gpui-kit.d.ts"],
      "gpui-base": ["./types/gpui-base.d.ts"]
    }
  },
  "include": ["mods/**/*.js", "tests/**/*.ts", "types/**/*.d.ts"]
}

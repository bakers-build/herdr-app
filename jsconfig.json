{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "checkJs": true,
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "herdr": ["./types/herdr.d.ts"]
    }
  },
  "include": [
    "mods/**/*.js",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.js",
    "types/**/*.d.ts"
  ]
}

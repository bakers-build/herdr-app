{
  "name": "herdr-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "test": "bun test --coverage && bun run coverage",
    "coverage": "bun scripts/check/coverage.ts",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run hygiene && bun run herdr-types && bun run test",
    "hygiene": "bun scripts/check/hygiene.ts",
    "herdr-types": "bun scripts/check/herdr-types.ts",
    "install:herdr": "bun scripts/install.ts",
    "release:package": "bun scripts/release/package.ts",
    "release:version": "bun scripts/release/version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}

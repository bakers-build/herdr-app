{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bb_run--bb_run"
        },
        "id": {
          "type": "string"
        },
        "attributes": {
          "description": "Entity attributes",
          "type": "object",
          "properties": {
            "drupal_internal__id": {
              "type": "integer",
              "title": "ID"
            },
            "created": {
              "type": "string",
              "title": "Created",
              "format": "date-time"
            },
            "changed": {
              "type": "string",
              "title": "Changed",
              "format": "date-time"
            },
            "state": {
              "type": "string",
              "title": "Run state",
              "oneOf": [
                {
                  "const": "claimed",
                  "title": "Claimed"
                },
                {
                  "const": "running",
                  "title": "Running"
                },
                {
                  "const": "done",
                  "title": "Done"
                },
                {
                  "const": "expired",
                  "title": "Expired"
                },
                {
                  "const": "failed",
                  "title": "Failed"
                },
                {
                  "const": "cancelled",
                  "title": "Cancelled"
                }
              ]
            },
            "claim_expires_at": {
              "type": "string",
              "title": "Claim expires at",
              "format": "date-time"
            },
            "state_changed": {
              "type": "string",
              "title": "Last run state change",
              "format": "date-time"
            },
            "state_at_start": {
              "type": "string",
              "title": "Ticket state at start",
              "maxLength": 255
            },
            "started_at": {
              "type": "string",
              "title": "Started at",
              "format": "date-time"
            },
            "heartbeat": {
              "type": "string",
              "title": "Heartbeat",
              "format": "date-time",
              "description": "Last time the owning conductor observed this run alive. Telemetry only; never drives reclaim."
            },
            "worktree_path": {
              "type": "string",
              "title": "Worktree path",
              "maxLength": 2048
            },
            "agent": {
              "type": "string",
              "title": "Agent",
              "maxLength": 255,
              "description": "Id of the agent the conductor chose for this run, for footprint routing. Records which agent ran; not selection state."
            },
            "harness": {
              "type": "string",
              "title": "Harness",
              "maxLength": 255,
              "description": "Id of the agent harness package that drove the session, e.g. claude or codex."
            },
            "model": {
              "type": "string",
              "title": "Model",
              "maxLength": 255,
              "description": "The candidate\\'s configured model, or the raw transcript model id when unconfigured. Empty only when both are unresolved."
            },
            "model_version": {
              "type": "string",
              "title": "Model version",
              "maxLength": 255,
              "description": "The candidate\\'s configured exact version, or the raw transcript model id when unconfigured. Empty only when both are unresolved."
            },
            "log": {
              "type": "object",
              "title": "Log",
              "properties": {
                "value": {
                  "type": "string",
                  "title": "Text"
                },
                "format": {
                  "type": "string",
                  "title": "Text format"
                }
              },
              "required": ["value"]
            },
            "error_log": {
              "type": "object",
              "title": "Error log",
              "properties": {
                "value": {
                  "type": "string",
                  "title": "Text"
                },
                "format": {
                  "type": "string",
                  "title": "Text format"
                }
              },
              "required": ["value"],
              "description": "Failure detail recorded when the run terminalised to failed (dispatch/setup error + relevant stderr)."
            },
            "log_sha256": {
              "type": "string",
              "title": "log checksum",
              "maxLength": 64
            },
            "log_bytes": {
              "type": "integer",
              "title": "log bytes"
            },
            "error_log_sha256": {
              "type": "string",
              "title": "error_log checksum",
              "maxLength": 64
            },
            "error_log_bytes": {
              "type": "integer",
              "title": "error_log bytes"
            },
            "run_log_storage_allowed": {
              "type": "boolean",
              "title": "Run log storage allowed",
              "description": "Whether the transcript of this run may be uploaded and stored now: the deployment flag and the workspace opt-in. Computed, read-only."
            },
            "log_upload_omitted": {
              "type": "boolean",
              "title": "Log upload omitted",
              "default": false
            },
            "closed": {
              "type": "boolean",
              "title": "Closed",
              "description": "Run is fully wound up: transcript captured and finalised. Distinct from the workflow state.",
              "default": false
            },
            "closed_date": {
              "type": "string",
              "title": "Closed date",
              "format": "date-time",
              "description": "When the run was finalised."
            },
            "tokens": {
              "type": "integer",
              "title": "Tokens",
              "default": 0
            },
            "duration_s": {
              "type": "integer",
              "title": "Duration in seconds",
              "default": 0
            },
            "agent_turns": {
              "type": "integer",
              "title": "Agent turns",
              "default": 0
            },
            "tool_calls": {
              "type": "integer",
              "title": "Tool calls",
              "default": 0
            },
            "user_prompts": {
              "type": "integer",
              "title": "User prompts",
              "default": 0
            },
            "user_prompt_words": {
              "type": "integer",
              "title": "User prompt words",
              "default": 0
            },
            "active_s": {
              "type": "integer",
              "title": "Active time in seconds",
              "default": 0
            },
            "state_flow": {
              "type": "string",
              "title": "State flow",
              "maxLength": 255
            },
            "duration": {
              "type": "string",
              "title": "Duration",
              "maxLength": 255
            }
          },
          "required": ["state"],
          "additionalProperties": false
        },
        "relationships": {
          "description": "Entity relationships",
          "properties": {
            "ticket_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_ticket--bb_ticket"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build ticket ID"
                    }
                  }
                }
              },
              "title": "Ticket"
            },
            "conductor_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_conductor--bb_conductor"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build conductor ID"
                    }
                  }
                }
              },
              "title": "Conductor"
            },
            "owner_user_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["user--user"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "User ID"
                    }
                  }
                }
              },
              "title": "Owner",
              "default": [
                {
                  "target_id": 0
                }
              ]
            },
            "log_file": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["file--file"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "File ID"
                    }
                  }
                }
              },
              "title": "log file"
            },
            "error_log_file": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["file--file"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "File ID"
                    }
                  }
                }
              },
              "title": "error_log file"
            }
          },
          "type": "object",
          "required": ["ticket_id"],
          "additionalProperties": false
        }
      },
      "required": ["type"]
    }
  },
  "required": ["data"],
  "x-dropsh-source": "jsonapi-schema",
  "x-dropsh-target": {
    "entity_type": "bb_run",
    "bundle": "bb_run"
  },
  "x-dropsh-operation": "create",
  "x-dropsh-schema-extensions": [],
  "x-dropsh-schema-pipeline-version": 2,
  "x-dropsh-operation-hook-plugins": ["bakers-name-refs"]
}

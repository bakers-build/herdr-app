{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bb_ticket--bb_ticket"
        },
        "id": {
          "type": "string"
        },
        "attributes": {
          "description": "Entity attributes",
          "type": "object",
          "properties": {
            "drupal_internal__id": {
              "type": "integer",
              "title": "ID"
            },
            "created": {
              "type": "string",
              "title": "Created",
              "format": "date-time"
            },
            "changed": {
              "type": "string",
              "title": "Changed",
              "format": "date-time"
            },
            "identifier": {
              "type": "string",
              "title": "Identifier",
              "maxLength": 255
            },
            "number": {
              "type": "integer",
              "title": "Number",
              "description": "The per-project running ticket number, allocated once on first save and frozen. Read-only; the identifier is built from it."
            },
            "workflow": {
              "type": "string",
              "title": "Workflow",
              "oneOf": [
                {
                  "const": "bb_work",
                  "title": "bakers.build work"
                }
              ]
            },
            "title": {
              "type": "string",
              "title": "Title",
              "maxLength": 255
            },
            "description": {
              "type": "object",
              "title": "Description",
              "properties": {
                "value": {
                  "type": "string",
                  "title": "Text"
                },
                "format": {
                  "type": "string",
                  "title": "Text format"
                }
              },
              "required": ["value"]
            },
            "state": {
              "type": "string",
              "title": "State"
            },
            "priority": {
              "type": "integer",
              "title": "Priority",
              "oneOf": [
                {
                  "const": 1,
                  "title": "High"
                },
                {
                  "const": 2,
                  "title": "Medium"
                },
                {
                  "const": 3,
                  "title": "Low"
                }
              ]
            },
            "time_estimate": {
              "type": "integer",
              "title": "Estimated time",
              "description": "Estimated effort in seconds, proposed at qualification and confirmed by a human."
            },
            "time_spent": {
              "type": "integer",
              "title": "Spent time",
              "description": "Accounted effort in seconds, proposed at review from the ticket runs and confirmed by a human."
            },
            "health": {
              "type": "string",
              "title": "Health",
              "oneOf": [
                {
                  "const": "healthy",
                  "title": "Healthy"
                },
                {
                  "const": "warning",
                  "title": "Warning"
                },
                {
                  "const": "critical",
                  "title": "Critical"
                }
              ]
            },
            "health_reason": {
              "type": "string",
              "title": "Health reason",
              "maxLength": 255
            },
            "health_moved": {
              "type": "string",
              "title": "Last real movement",
              "format": "date-time"
            },
            "health_checked": {
              "type": "string",
              "title": "Health evaluated",
              "format": "date-time"
            },
            "origin": {
              "type": "string",
              "title": "Origin URL",
              "maxLength": 2048
            },
            "links": {
              "type": "array",
              "title": "Links",
              "items": {
                "type": "object",
                "title": "Options",
                "properties": {
                  "uri": {
                    "type": "string",
                    "title": "URI",
                    "format": "uri"
                  },
                  "title": {
                    "type": "string",
                    "title": "Link text"
                  }
                }
              }
            },
            "metrics": {
              "type": "array",
              "title": "Metrics",
              "description": "Named success metrics for this ticket.",
              "items": {
                "type": "object",
                "title": "bakers.build metric",
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "Name"
                  },
                  "value": {
                    "type": "string",
                    "title": "Value"
                  },
                  "unit": {
                    "type": "string",
                    "title": "Unit"
                  },
                  "recorded": {
                    "type": "string",
                    "title": "Recorded",
                    "format": "date-time"
                  }
                },
                "required": ["name", "value"]
              }
            },
            "env_vars": {
              "type": "string",
              "title": "Environment variables",
              "description": ".env-style KEY=value lines (one per line, # comments allowed). Inherited by sub-tickets; injected into hooks + the agent by the conductor. Readable by anyone who can view this ticket."
            },
            "effective_env_vars": {
              "type": "string",
              "title": "Effective environment variables",
              "description": "env_vars resolved along the parent chain (child wins). Computed, read-only."
            },
            "branch_name": {
              "type": "string",
              "title": "Branch name",
              "maxLength": 255,
              "description": "Git branch for the ticket. May be supplied at creation — that is how a ticket lands on an existing release or integration branch; left empty it is derived on first save from the repo branch convention (default feat/-, capped at 30 chars). Frozen once the ticket exists."
            },
            "base_branch": {
              "type": "string",
              "title": "Base branch",
              "maxLength": 255,
              "description": "Branch the ticket\\'s work is based on (computed; never writable): the direct parent\\'s branch_name when the ticket has a parent — so a child inherits its parent\\'s release or integration branch — else the first project repo default_branch, else \\\"main\\\". Consumed by the conductor (worktree base) and the coding skill (MR target)."
            },
            "target_branch": {
              "type": "string",
              "title": "Target branch",
              "maxLength": 255,
              "description": "Branch the ticket\\'s work merges into (computed; never writable): a deployment ticket with exactly one environment merges into that environment\\'s branch, every other ticket into base_branch. Consumed by the forge tools (PR/MR target)."
            },
            "frozen": {
              "type": "boolean",
              "title": "Frozen",
              "description": "When set, conductors skip this ticket at the next claim. Setting it cancels the active runs.",
              "default": false
            },
            "frozen_at": {
              "type": "string",
              "title": "Frozen at",
              "format": "date-time",
              "description": "When the operator hold started. Cleared when the ticket is unfrozen. Stamped by the server from `frozen`, never by the client."
            },
            "closed": {
              "type": "boolean",
              "title": "Closed",
              "description": "Ticket is fully wound up; nothing more will happen. Distinct from the workflow state.",
              "default": false
            },
            "closed_date": {
              "type": "string",
              "title": "Closed date",
              "format": "date-time",
              "description": "When the ticket was finalised."
            },
            "cleaned_up": {
              "type": "boolean",
              "title": "Cleaned up",
              "description": "The ticket\\'s herdr worktree has been torn down. Distinct from `closed`: `closed` is the ticket lifecycle, `cleaned_up` is the infra teardown, so a teardown miss keeps `cleaned_up`=FALSE (retried by the conductor reaper) without withholding the close.",
              "default": false
            },
            "cleaned_up_date": {
              "type": "string",
              "title": "Cleaned up date",
              "format": "date-time",
              "description": "When the worktree teardown was recorded. Distinct from `closed_date`: the two lifecycles are independent, so a ticket may be closed with this NULL, or this set while the ticket is still open."
            },
            "derived_status": {
              "type": "string",
              "title": "Derived status",
              "maxLength": 255
            },
            "work_state": {
              "type": "string",
              "title": "Work state",
              "maxLength": 255
            },
            "stall_reason": {
              "type": "string",
              "title": "Stall reason",
              "maxLength": 255,
              "description": "Why this ticket is standing still: frozen, blocked, no conductor, conductor no access, or failing."
            },
            "claim_machine": {
              "type": "string",
              "title": "Claim machine",
              "maxLength": 255
            },
            "since_label": {
              "type": "string",
              "title": "Since",
              "maxLength": 255
            },
            "assignee_initials": {
              "type": "string",
              "title": "Assignee initials",
              "maxLength": 255
            },
            "assignee_name": {
              "type": "string",
              "title": "Assignee name",
              "maxLength": 255
            },
            "assignee_color": {
              "type": "string",
              "title": "Assignee colour",
              "maxLength": 255
            },
            "recipient_profile": {
              "type": "string",
              "title": "Recipient profile"
            },
            "owner_name": {
              "type": "string",
              "title": "Owner name",
              "maxLength": 255
            },
            "owner_initials": {
              "type": "string",
              "title": "Owner initials",
              "maxLength": 255
            },
            "state_flow": {
              "type": "string",
              "title": "State flow",
              "maxLength": 255
            },
            "edit_url": {
              "type": "string",
              "title": "Edit URL",
              "maxLength": 255
            },
            "type_names": {
              "type": "string",
              "title": "Ticket type names (comma-separated type term names; one name; resolved in the ticket's workspace and created there when missing, on the live write)"
            },
            "recipe_names": {
              "type": "string",
              "title": "Recipe names (comma-separated recipe term names; one name; resolved in the ticket's workspace and created there when missing, on the live write)"
            },
            "label_names": {
              "type": "string",
              "title": "Label names (comma-separated label term names; resolved in the ticket's workspace and created there when missing, on the live write)"
            },
            "environment_names": {
              "type": "string",
              "title": "Environment names (comma-separated; unique per project, so an ambiguous name is narrowed by the project_id of the write — resolved to environments on the live write)"
            }
          },
          "required": ["title"],
          "additionalProperties": false
        },
        "relationships": {
          "description": "Entity relationships",
          "properties": {
            "project_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_project--bb_project"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build project ID"
                    }
                  }
                }
              },
              "title": "Project"
            },
            "ticket_type": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_term--type"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build term ID"
                    }
                  }
                }
              },
              "title": "Ticket type"
            },
            "recipe": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_term--recipe"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build term ID"
                    }
                  }
                }
              },
              "title": "Recipe"
            },
            "labels": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_term--label"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build term ID"
                      }
                    }
                  }
                }
              },
              "title": "Labels"
            },
            "assignee_user_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["user--user"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "User ID"
                    }
                  }
                }
              },
              "title": "Assignee user"
            },
            "reviewers": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["user--user"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "User ID"
                      }
                    }
                  }
                }
              },
              "title": "Reviewers"
            },
            "conductor_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_conductor--bb_conductor"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build conductor ID"
                    }
                  }
                }
              },
              "title": "Conductor",
              "description": "The conductor this ticket is assigned to. Assigning a conductor is what starts a run, and it fills an empty user assignee with the conductor\\'s owner; an assignee that is already set is never overwritten."
            },
            "template_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_ticket_template--bb_ticket_template"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build ticket template ID"
                    }
                  }
                }
              },
              "title": "Template",
              "description": "The ticket template this ticket was generated from, if any."
            },
            "parent_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_ticket--bb_ticket"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build ticket ID"
                    }
                  }
                }
              },
              "title": "Parent ticket"
            },
            "blocked_by": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_ticket--bb_ticket"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build ticket ID"
                      }
                    }
                  }
                }
              },
              "title": "Blocked by"
            },
            "referenced_tickets": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_ticket--bb_ticket"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build ticket ID"
                      }
                    }
                  }
                }
              },
              "title": "Referenced tickets",
              "description": "Tickets carried by this deployment (the release batch). Set when the deployment is planned. The environments of the deployment say where they are deployed; the carried tickets are not stamped."
            },
            "environments": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_environment--bb_environment"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build environment ID"
                      }
                    }
                  }
                }
              },
              "title": "Environments",
              "description": "The managed environments this ticket concerns."
            },
            "comments": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_comment--bb_comment"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build comment ID"
                      }
                    }
                  }
                }
              },
              "title": "Comments"
            },
            "handoff_comments": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_comment--bb_comment"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build comment ID"
                      }
                    }
                  }
                }
              },
              "title": "Handoff comments",
              "description": "Every comment on the ticket whose type is not \\\"summary\\\", oldest first (computed; never writable)."
            },
            "summary_comment": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_comment--bb_comment"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build comment ID"
                    }
                  }
                }
              },
              "title": "Summary comment",
              "description": "The newest comment on the ticket typed \\\"summary\\\" — the latest phase handoff (computed; never writable)."
            },
            "pending_reviews": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_comment--bb_comment"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build comment ID"
                      }
                    }
                  }
                }
              },
              "title": "Pending reviews",
              "description": "Submitted reviews awaiting a decision by the current assignee (computed; never writable)."
            },
            "sub_tickets": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_ticket--bb_ticket"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build ticket ID"
                      }
                    }
                  }
                }
              },
              "title": "Sub-tickets"
            },
            "deployments": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_ticket--bb_ticket"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build ticket ID"
                      }
                    }
                  }
                }
              },
              "title": "Deployed to",
              "description": "Deployment tickets whose referenced tickets contain this ticket (computed; never writable)."
            },
            "runs": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "id"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "title": "Referenced resource",
                        "enum": ["bb_run--bb_run"]
                      },
                      "id": {
                        "type": "string",
                        "title": "Resource ID",
                        "format": "uuid",
                        "maxLength": 128
                      },
                      "meta": {
                        "type": "integer",
                        "title": "bakers.build run ID"
                      }
                    }
                  }
                }
              },
              "title": "Runs"
            },
            "owner_user_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["user--user"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "User ID"
                    }
                  }
                }
              },
              "title": "Owner"
            }
          },
          "type": "object",
          "required": ["project_id"],
          "additionalProperties": false
        }
      },
      "required": ["type"]
    }
  },
  "required": ["data"],
  "x-dropsh-source": "jsonapi-schema",
  "x-dropsh-target": {
    "entity_type": "bb_ticket",
    "bundle": "bb_ticket"
  },

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bb_conductor--bb_conductor"
        },
        "id": {
          "type": "string"
        },
        "attributes": {
          "description": "Entity attributes",
          "type": "object",
          "properties": {
            "drupal_internal__id": {
              "type": "integer",
              "title": "ID"
            },
            "created": {
              "type": "string",
              "title": "Created",
              "format": "date-time"
            },
            "changed": {
              "type": "string",
              "title": "Changed",
              "format": "date-time"
            },
            "conductor_id": {
              "type": "string",
              "title": "Conductor ID",
              "maxLength": 255
            },
            "label": {
              "type": "string",
              "title": "Label",
              "maxLength": 255
            },
            "active": {
              "type": "boolean",
              "title": "Active",
              "description": "Inactive conductors cannot be assigned and claim no work.",
              "default": true
            },
            "status": {
              "type": "string",
              "title": "Status",
              "oneOf": [
                {
                  "const": "online",
                  "title": "Online"
                },
                {
                  "const": "offline",
                  "title": "Offline"
                }
              ],
              "default": "offline"
            },
            "states": {
              "type": "array",
              "title": "States",
              "items": {
                "type": "string",
                "title": "Text value",
                "anyOf": [
                  {
                    "const": "plan",
                    "title": "Plan"
                  },
                  {
                    "const": "qualification",
                    "title": "Qualification"
                  },
                  {
                    "const": "review",
                    "title": "Review"
                  },
                  {
                    "const": "working",
                    "title": "Working"
                  }
                ]
              }
            },
            "workspace_root": {
              "type": "string",
              "title": "Workspace root",
              "maxLength": 2048
            },
            "reported_load": {
              "type": "integer",
              "title": "Reported load",
              "description": "This conductor process load last reported on heartbeat; aggregated into machine.current_load.",
              "default": 0
            },
            "last_seen": {
              "type": "string",
              "title": "Last seen",
              "format": "date-time"
            },
            "lease_expires_at": {
              "type": "string",
              "title": "Lease expires at",
              "format": "date-time"
            },
            "last_pid": {
              "type": "integer",
              "title": "Last PID",
              "description": "The process id last reported by the conductor serve loop. The last known pid — never a liveness signal."
            },
            "conductor_name": {
              "type": "string",
              "title": "Conductor name",
              "maxLength": 255,
              "description": "The config file stem the conductor was started from, as accepted by --conductor."
            },
            "node_status": {
              "type": "string",
              "title": "Node status",
              "maxLength": 255
            },
            "node_states_label": {
              "type": "string",
              "title": "Node states",
              "maxLength": 255
            },
            "node_load_label": {
              "type": "string",
              "title": "Node load",
              "maxLength": 255
            },
            "last_seen_label": {
              "type": "string",
              "title": "Last seen label",
              "maxLength": 255
            }
          },
          "required": ["conductor_id"],
          "additionalProperties": false
        },
        "relationships": {
          "description": "Entity relationships",
          "properties": {
            "owner_user_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["user--user"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "User ID"
                    }
                  }
                }
              },
              "title": "Owner",
              "default": [
                {
                  "target_id": 0
                }
              ]
            },
            "project_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_project--bb_project"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build project ID"
                    }
                  }
                }
              },
              "title": "Project"
            },
            "machine": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_machine--bb_machine"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build machine ID"
                    }
                  }
                }
              },
              "title": "Machine"
            }
          },
          "type": "object",
          "required": ["project_id"],
          "additionalProperties": false
        }
      },
      "required": ["type"]
    }
  },
  "required": ["data"],
  "x-dropsh-source": "jsonapi-schema",
  "x-dropsh-target": {
    "entity_type": "bb_conductor",
    "bundle": "bb_conductor"
  },
  "x-dropsh-operation": "create",
  "x-dropsh-schema-extensions": [],
  "x-dropsh-schema-pipeline-version": 2,
  "x-dropsh-operation-hook-plugins": ["bakers-name-refs"]
}

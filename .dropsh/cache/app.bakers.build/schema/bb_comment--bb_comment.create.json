{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bb_comment--bb_comment"
        },
        "id": {
          "type": "string"
        },
        "attributes": {
          "description": "Entity attributes",
          "type": "object",
          "properties": {
            "drupal_internal__id": {
              "type": "integer",
              "title": "ID"
            },
            "created": {
              "type": "string",
              "title": "Created",
              "format": "date-time"
            },
            "changed": {
              "type": "string",
              "title": "Changed",
              "format": "date-time"
            },
            "status": {
              "type": "boolean",
              "title": "Published",
              "default": true
            },
            "body": {
              "type": "object",
              "title": "Body",
              "properties": {
                "value": {
                  "type": "string",
                  "title": "Text"
                },
                "format": {
                  "type": "string",
                  "title": "Text format"
                }
              },
              "required": ["value"]
            },
            "bb_comment_type": {
              "type": "string",
              "title": "Type",
              "maxLength": 255,
              "description": "Free text. Conventional values: comment, qualification, spec, plan, debug_diagnose, summary, acceptance, scenario, test.",
              "default": "comment"
            },
            "review_state": {
              "type": "string",
              "title": "Review state",
              "oneOf": [
                {
                  "const": "draft",
                  "title": "Draft"
                },
                {
                  "const": "submitted",
                  "title": "Submitted"
                },
                {
                  "const": "accepted",
                  "title": "Accepted"
                },
                {
                  "const": "rejected",
                  "title": "Rejected"
                }
              ]
            },
            "submitted_at": {
              "type": "string",
              "title": "Submitted at",
              "format": "date-time"
            },
            "decided_at": {
              "type": "string",
              "title": "Decided at",
              "format": "date-time"
            },
            "author_name": {
              "type": "string",
              "title": "Author name",
              "maxLength": 255
            },
            "author_initials": {
              "type": "string",
              "title": "Author initials",
              "maxLength": 255
            },
            "author_color": {
              "type": "string",
              "title": "Author colour",
              "maxLength": 255
            }
          },
          "required": ["body", "bb_comment_type"],
          "additionalProperties": false
        },
        "relationships": {
          "description": "Entity relationships",
          "properties": {
            "bundle": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_comment_type--bb_comment_type"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "string",
                      "title": "bakers.build comment type ID"
                    }
                  }
                }
              },
              "title": "Comment type"
            },
            "ticket_id": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["bb_ticket--bb_ticket"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "bakers.build ticket ID"
                    }
                  }
                }
              },
              "title": "Ticket"
            },
            "author": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["user--user"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "User ID"
                    }
                  }
                }
              },
              "title": "Author"
            },
            "decided_by": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["type", "id"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Referenced resource",
                      "enum": ["user--user"]
                    },
                    "id": {
                      "type": "string",
                      "title": "Resource ID",
                      "format": "uuid",
                      "maxLength": 128
                    },
                    "meta": {
                      "type": "integer",
                      "title": "User ID"
                    }
                  }
                }
              },
              "title": "Decided by"
            }
          },
          "type": "object",
          "required": ["ticket_id"],
          "additionalProperties": false
        }
      },
      "required": ["type"]
    }
  },
  "required": ["data"],
  "x-dropsh-source": "jsonapi-schema",
  "x-dropsh-target": {
    "entity_type": "bb_comment",
    "bundle": "bb_comment"
  },
  "x-dropsh-operation": "create",
  "x-dropsh-schema-extensions": [],
  "x-dropsh-schema-pipeline-version": 2,
  "x-dropsh-operation-hook-plugins": ["bakers-name-refs"]
}
